# Modello del file .env: copialo in un file chiamato .env e metti i valori veri.
# Questo file va su GitHub, il .env NO.

# Indirizzo del database (in sviluppo usiamo un file SQLite locale)
DATABASE_URL=sqlite:///./bottega.db

# Chiave segreta usata per firmare i login (in .env metti una stringa lunga e casuale)
SECRET_KEY=cambiami-con-una-stringa-casuale

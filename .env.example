# Copia questo file in .env e metti i valori veri.
# .env.example va su GitHub, .env no.

# Percorso relativo alla cartella del progetto
DATABASE_URL=sqlite:///bottega.db

# Almeno 32 caratteri casuali: con questo valore d'esempio l'app non parte.
# Per generarne una: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiami-con-una-stringa-casuale

# In produzione (sito su HTTPS) mettilo a true: il cookie di login viaggia solo cifrato
SESSION_HTTPS_ONLY=false

# --- Solo per la versione online (Vercel + Neon) ---
# DATABASE_URL=postgresql://utente:password@host/database?sslmode=require
# DEMO_MODE=true             # pulsante "Prova la demo": attività di prova personale, cancellata dopo 24 ore
# MIGRATE_ON_STARTUP=true    # l'app crea e aggiorna le tabelle da sola all'avvio
# TRUST_FORWARDED_FOR=true   # solo dietro Vercel: l'IP vero del visitatore arriva in X-Forwarded-For
